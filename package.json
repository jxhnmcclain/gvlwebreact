{
  "name": "growth-video-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content:sync": "node scripts/sync-content.mjs",
    "content:sync:directus-local": "node scripts/sync-content.mjs --directus-local",
    "content:sync:directus-prod": "node scripts/sync-content.mjs --directus-prod",
    "cms:start": "docker compose -f tools/directus-local/docker-compose.yml up -d && node tools/directus-local/bootstrap.mjs && node tools/directus-local/provision-hermes.mjs",
    "cms:import-blog": "node tools/directus-local/migrate-local-posts.mjs",
    "cms:preview": "npm run dev:directus-local",
    "supabase:production-bootstrap": "node scripts/build-production-bootstrap.mjs",
    "predev": "npm run content:sync",
    "dev": "vite",
    "dev:directus-local": "npm run content:sync:directus-local && vite",
    "prebuild": "npm run content:sync",
    "build": "vite build",
    "build:directus-local": "npm run content:sync:directus-local && vite build",
    "prebuild:vercel": "npm run content:sync:directus-prod",
    "build:vercel": "vite build --mode vercel",
    "prebuild:prerender": "npm run content:sync",
    "build:prerender": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@types/react-helmet": "^6.1.11",
    "clsx": "latest",
    "date-fns": "^4.1.0",
    "framer-motion": "10.16.4",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "lucide-react": "0.344.0",
    "postprocessing": "^6.36.0",
    "puppeteer": "^25.8.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "react-turnstile": "1.1.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "latest",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
